model Purchase {
  id    String  @id @default(uuid())
  price Decimal @db.Decimal(10, 2)

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items PurchaseItem[]

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("purchases")
}
